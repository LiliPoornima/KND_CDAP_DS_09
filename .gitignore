# Component 02: private/raw and generated data
/data/financial_inclusion/raw/*
!/data/financial_inclusion/raw/.gitkeep

/data/financial_inclusion/processed/*
!/data/financial_inclusion/processed/.gitkeep


# Component 02: generated analysis outputs

# Ignore generated reports by default. Narrow, reviewed Component 02
# aggregate exceptions are listed at the end of this file.
/outputs/financial_inclusion/reports/*
!/outputs/financial_inclusion/reports/.gitkeep

/outputs/financial_inclusion/figures/*
!/outputs/financial_inclusion/figures/.gitkeep

# Ignore generated metrics by default; allow reviewed findings
/outputs/financial_inclusion/metrics/*
!/outputs/financial_inclusion/metrics/.gitkeep

# Component 02 - locally generated trained model artifacts
/models/financial_inclusion/*.joblib

# Generated model files
models/**/*.joblib
models/**/*.pkl
*.joblib
*.pkl

# Generated plots and JSON outputs
outputs/**/*.png
outputs/**/*.json

# Component 02 respondent-level outputs already present in the working tree.
# Keep these local; .gitignore does not stop tracking until removed from the index.
/outputs/financial_inclusion/reports/04_supervised_learning/fi_supervised_dataset_audit.csv
/outputs/financial_inclusion/experiments/supervised_tuning/shap/local_explanations.csv
/outputs/financial_inclusion/experiments/supervised_tuning/shap/predictions.csv

